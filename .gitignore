# ---------------------------------------------------------------------------
# СЕКРЕТЫ — ничего из этого не должно попасть в публичный репозиторий
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
secrets.yaml
!secrets.example.yaml
*.pem
*.key
!*.pub
.jwt_secret
config.yaml
!config.example.yaml
!frigate/config.example.yaml
# манифесты аддонов Home Assistant: секретов в них нет, пароли задаются в UI
!services/*/config.yaml
cloudflared-config.yml
credentials.json
*credentials*.json
.cloudflared/

# ---------------------------------------------------------------------------
# ПЕРСОНАЛЬНЫЕ ДАННЫЕ — видео, фото лиц, базы событий
# ЭТО КРИТИЧНО: в media/ и frigate.db лежат записи родственников
# ---------------------------------------------------------------------------
media/
recordings/
clips/
snapshots/
recovered/
faces/
train/
test_pictures/
*.mp4
*.mkv
*.jpg
*.jpeg
*.png
!docs/assets/**/*.png
!docs/assets/**/*.jpg
!docs/assets/**/*.svg
!site/**/*.png
!site/**/*.jpg
!site/**/*.svg
!site/**/*.webp

# ---------------------------------------------------------------------------
# БАЗЫ ДАННЫХ И РАНТАЙМ-СОСТОЯНИЕ
# ---------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.storage/
.cache/
.exports
.timeline
.vacuum
.search_stats.json
*.log
*.log.*
.ha_run.lock
tts/
deps/

# ---------------------------------------------------------------------------
# МОДЕЛИ — веса тяжёлые, собираются скриптом, а не хранятся в git
# ---------------------------------------------------------------------------
model_cache/
*.onnx
*.pt
*.pth
*.engine
*.tflite
*.hef

# ---------------------------------------------------------------------------
# PYTHON
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# NODE (для site/ на шагах 2-4)
# ---------------------------------------------------------------------------
node_modules/
dist/
.next/
.wrangler/
.vercel/

# ---------------------------------------------------------------------------
# IDE И ОС
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

.repo-staging/
.repo-secrets.local
*.from-host
frigate/config.from-host.yaml
