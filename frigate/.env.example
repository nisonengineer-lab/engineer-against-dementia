# ===========================================================================
#  Секреты для Frigate. Скопируй в .env рядом с docker-compose.yml:
#      cp .env.example .env
#  .env уже в .gitignore — он НИКОГДА не должен попасть в репозиторий.
#
#  Frigate подставляет только переменные с префиксом FRIGATE_ и только
#  в тех полях конфига, где это разрешено (mqtt.*, ffmpeg.inputs.path).
# ===========================================================================

# --- MQTT-брокер (Mosquitto add-on внутри Home Assistant) ------------------
FRIGATE_MQTT_HOST=10.0.0.XX
FRIGATE_MQTT_USER=changeme
FRIGATE_MQTT_PASSWORD=changeme

# --- RTSP-доступ к камерам ------------------------------------------------
# У EZVIZ пароль RTSP — это код верификации с наклейки на корпусе,
# а НЕ пароль от аккаунта в приложении. Меняется только сбросом камеры.
FRIGATE_RTSP_USER=admin
FRIGATE_RTSP_PASSWORD_YARD=changeme
FRIGATE_RTSP_PASSWORD_INDOOR=changeme

# --- Часовой пояс ---------------------------------------------------------
TZ=Asia/Jerusalem
